     "text": [
      "        Monthly Volatility (%)\n",
      "ticker                        \n",
      "AAPL                      3.74\n",
      "EQNR                      4.50\n",
      "MSFT                      4.15\n",
      "NVDA                     16.96\n"
     ]
    }
   ],
   "source": [
    "#Deliverable 2 monthly volatility\n",
    "prices = df.pivot(index='date', columns='ticker', values='close')\n",
    "latest_prices = prices.iloc[-1]\n",
    "returns = prices.pct_change()\n",
    "volatility = returns.std()\n",
    "vol_table = (returns.std() * 100).round(2).to_frame(name=\"Monthly Volatility (%)\")\n",
    "print(vol_table)\n"
   ]
  },
