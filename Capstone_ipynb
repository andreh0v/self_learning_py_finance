   "source": [
    "#Deliverable 4 total portfolio in USD\n",
    "def holding_value_usd(row):\n",
    "    ticker = row['ticker']\n",
    "    if ticker in latest_prices.index:\n",
    "        price = latest_prices[ticker]\n",
    "        local_value = price * row['shares']\n",
    "        return convert_to_usd(local_value,row['currency'], EX_rate)\n",
    "    else:\n",
    "        return 0\n",
    "\n",
    "port['value_usd'] = port.apply(holding_value_usd, axis = 1)\n",
    "total = port['value_usd'].sum()\n",
    "print(f\"Total portfolio value today $ {total:.2f} USD\")"
   ]
  },
