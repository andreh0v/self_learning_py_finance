   ],
   "source": [
    "#Deliverable 3 avrage monthly return\n",
    "AVG_return = returns.mean()\n",
    "Best_return = AVG_return.idxmax()\n",
    "Worst_return = AVG_return.idxmin()\n",
    "print((AVG_return * 100).round(2))    # ✅ round the values, then print\n",
    "print(f\" Best performer {Best_return}\")\n",
    "print(f\" Worst performer {Worst_return}\")"
   ]
  },
