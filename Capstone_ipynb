   "source": [
    "#Deliverable 1\n",
    "query = '''\n",
    "    SELECT Ticker,\n",
    "            COUNT(*) AS Months,\n",
    "            AVG(close) AS AVG_plose_price,\n",
    "            MIN(close) AS Low_close_price,\n",
    "            MAX(close) AS High_close_price\n",
    "    FROM Prices\n",
    "    GROUP by Ticker\n",
    "'''\n",
    "summary = pd.read_sql(query,conn)\n",
    "print(summary)"
   ]
  },
  {
   "cell_type": "code",
